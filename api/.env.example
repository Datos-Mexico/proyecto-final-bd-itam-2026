# Plantilla de variables de entorno para correr la API localmente.
# Copia este archivo a `.env` y completa los valores apropiados.
# `.env` está en .gitignore — nunca se commitea.

# Conexión a Postgres local (driver asyncpg).
# Para el proyecto académico se asume una instancia local en localhost.
# El valor debe ser una URL postgresql+asyncpg con tu usuario, contraseña,
# host (localhost), puerto (5432 por defecto), y nombre de base.
# Reemplaza YOUR_CREDENTIALS por el par usuario y contraseña separados
# por dos puntos (formato URL estándar de SQLAlchemy).
DATABASE_URL=postgresql+asyncpg://YOUR_CREDENTIALS@localhost:5432/proyecto_academico

# Orígenes permitidos por CORS. Por defecto solo localhost.
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Pool de conexiones.
POOL_SIZE=5
MAX_OVERFLOW=10

# Modo testing — desactiva rate limiting y warnings de secret_key.
TESTING=false

# Clave secreta para firmar JWT (HS256). Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NUNCA usar el valor placeholder en cualquier entorno real.
SECRET_KEY=replace-with-your-own-secret-key-min-32-chars

# Algoritmo de firma de JWT.
ALGORITHM=HS256

# Tiempo de expiración de tokens en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=30
